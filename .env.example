# Database
DATABASE_URL="postgresql://user:password@localhost:5432/keytao?schema=public"

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET="your-secret-key-change-me-in-production"

# Node Environment
NODE_ENV="development"

# Github Sync Configuration
# Option 1: GitHub App (Recommended for organizations)
GITHUB_APP_ID="123456"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEpAIBAAKCAQEA1234567890abcdefghijklmnopqrstuvwxyz...
... (paste your complete private key content here) ...
-----END RSA PRIVATE KEY-----"
GITHUB_APP_INSTALLATION_ID="12345678"

# Option 2: Personal Access Token (Legacy, simpler setup)
# GITHUB_TOKEN="ghp_your_github_personal_access_token"

# Repository settings
GITHUB_OWNER="xkinput"
GITHUB_REPO="KeyTao"
GITHUB_BASE_BRANCH="master"

# Vercel Cron Secret (optional, for securing cron endpoints)
CRON_SECRET="your-cron-secret-key"

# Bot API Token (for bot endpoint authentication, minimum 32 characters)
# Generate with: openssl rand -hex 32
#
# Doubles as the HMAC secret for the web chat identity headers. /api/bot/chat
# signs, in lowercase hex:
#   X-Web-User-Sig = HMAC_SHA256(
#     BOT_API_TOKEN,
#     `${METHOD}.${path}.${userId}.${unixSeconds}`
#   )
# where METHOD is upper case and `path` is the upstream path only, e.g.
#   POST./api/chat.42.1784030400
#   DELETE./api/chat/history.42.1784030400
# keytao-bot recomputes the same digest and rejects anything outside a +/-300s
# window. Binding method and path stops a signature captured from one endpoint
# being replayed against the other. Both sides must share the exact same value.
#
# REQUIRED for web chat: if this is unset, /api/bot/chat returns HTTP 500 rather
# than forwarding an unsigned request (an unsigned request would leave the bot
# trusting only the body-supplied user_id, which any caller can forge).
BOT_API_TOKEN="your-bot-api-token-min-32-characters-long-change-me"
# Dedicated HMAC secret for Next↔Bot user identity delegation (minimum 32 characters)
# Do not reuse BOT_API_TOKEN. Both services must use the same value.
BOT_IDENTITY_SECRET="your-shared-bot-identity-secret-min-32-characters"

# Live2D Chat Widget — keytao-bot HTTP API
BOT_API_URL="http://localhost:8080"
# BOT_API_KEY=""  # set if WEB_API_KEY is configured in keytao-bot
SEMANTIC_PRONUNCIATION_TIMEOUT_MS="30000"

# ---------------------------------------------------------------------------
# Dedicated bot account (scripts/initBotUser.ts, run via `pnpm run init:bot-user`)
# ---------------------------------------------------------------------------
# Creates the machine account that owns the 喵喵Bot draft batches and carries the
# R:BOT role. Only an account with R:BOT may call
# POST /api/bot/batches/:id/auto-approve.
#
# Display/login name of the bot account (defaults to 喵喵Bot)
# BOT_USER_NAME="喵喵Bot"
# Optional email for the bot account
# BOT_USER_EMAIL="bot@example.com"
# Optional password; when omitted a random one is generated and printed once
# BOT_USER_PASSWORD=""
# QQ id to bind to the bot account, so the bot can call platform-bound
# endpoints as itself (platform=qq&platformId=$BOT_QQ_ID)
# BOT_QQ_ID=""

# Live2D model URL (Cubism 2/3/4)
# Default: Shizuku free demo model
NEXT_PUBLIC_LIVE2D_MODEL="https://cdn.jsdelivr.net/npm/live2d-widget-model-shizuku@1.0.5/assets/shizuku.model.json"
